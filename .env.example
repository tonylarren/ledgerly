# Copy to .env on the server and fill in. Never commit .env.

# Lets you type plain `docker compose ...` in this folder instead of adding -f docker-compose.prod.yml.
COMPOSE_FILE=docker-compose.prod.yml

# Public hostname pointing at this server (DNS A record). Caddy gets the HTTPS certificate for it.
DOMAIN=ledger.example.com

# Leave false: the first account becomes admin, then admins/owners create other accounts.
ALLOW_SIGNUP=false

# Optional instance-wide email (each organisation can also set its own in Settings → Email).
# Use port 587 (STARTTLS) or 465 (TLS); many hosts block outgoing port 25.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
